{
    "name": "@cocos-fe/electron-badge",
    "version": "0.0.8",
    "description": "Electron badge for win32 and Unix",
    "type": "commonjs",
    "scripts": {
        "build": "npm run build:main & npm run build:render",
        "build:main": "cd ./main && npx tsc",
        "build:render": "cd ./render && npx tsc"
    },
    "devDependencies": {
        "typescript": "^5.6.2"
    },
    "exports": {
        ".": {
            "require": "./dist/main/index.js",
            "types": "./dist/main/index.d.ts"
        },
        "./main": {
            "types": "./dist/main/index.d.ts",
            "require": "./dist/main/index.js"
        },
        "./render": {
            "types": "./dist/render/index.d.ts",
            "require": "./dist/render/index.js"
        }
    },
    "files": [
        "./dist/*"
    ],
    "license": "ISC",
    "engines": {
        "node": ">=18"
    },
    "peerDependencies": {
        "electron": ">=29.0.0"
    },
    "peerDependenciesMeta": {
        "electron": {
            "optional": true
        }
    },
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org"
    },
    "keywords": [
        "electron",
        "badge",
        "dock",
        "setOverlayIcon",
        "setBadge"
    ]
}